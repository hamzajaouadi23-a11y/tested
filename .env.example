# TESTÉ & PROPRE — Content OS · Exemple de configuration (.env)
# Copier ce fichier en .env (celui-ci reste HORS git, jamais commité).
# Règle absolue : les clés ne vont JAMAIS dans le frontend, ni dans le dépôt, ni dans les backups.

# --- TEXT (chaîne : Gemini → Groq → Mistral → OpenRouter → local) ---
GEMINI_API_KEY=VOTRE_CLE_GEMINI
GROQ_API_KEY=VOTRE_CLE_GROQ
MISTRAL_API_KEY=VOTRE_CLE_MISTRAL
OPENROUTER_API_KEY=VOTRE_CLE_OPENROUTER

# --- VOICE (chaîne : ElevenLabs → Azure → import opérateur — fallback toujours signalé) ---
ELEVENLABS_API_KEY=VOTRE_CLE_ELEVENLABS
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # optionnel : id voix (défaut Rachel)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2 # optionnel : modèle (défaut multilingue v2)
AZURE_SPEECH_KEY=VOTRE_CLE_AZURE
AZURE_SPEECH_REGION=francecentral
AZURE_SPEECH_VOICE=fr-FR-DeniseNeural      # optionnel : voix neuronale Azure FR (sinon défaut)
AZURE_SPEECH_RATE=+8%                      # optionnel : débit SSML (+0% lent+, +20% rapide)

# --- SOCIAL (OAuth officiel — jamais contourné ; optionnel, publication manuelle sinon) ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# --- Flags d'automatisation ---
AUTO_RESEARCH=true
AUTO_GENERATION=true
AUTO_RENDER=true
AUTO_PUBLISH=false
AUTO_ANALYTICS=false
